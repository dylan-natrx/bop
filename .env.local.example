# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to the repository.

# Mapbox public token, 94 characters. Inlined at build time on Vercel.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# --- Platform access gate (src/lib/platform/gate.ts) ---
# Tenant credentials live as bcrypt hashes in src/lib/platform/tenants.ts;
# no plaintext credential exists anywhere. Session cookies are HMAC values
# keyed by this secret. Rotate it to invalidate every session on every
# tenant. Gated tenants fail closed if it is missing.
PLATFORM_SESSION_SECRET=generate_64_hex_chars_eg_openssl_rand_hex_32

# Optional: which tenant localhost and Vercel preview URLs serve
# (defaults to bop). A ?tenant=<slug> query param also works there.
# PLATFORM_DEFAULT_TENANT=bop
