# Copy this file to .env.local and fill in real values.
# Do NOT commit .env.local to the repository.

# Mapbox public token, 94 characters. Inlined at build time on Vercel.
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# --- Pre-public password gate (delete these when the page goes public) ---
# Middleware at the project root (middleware.ts) checks for the bop-auth
# cookie on every request. The /api/auth/login route compares submitted
# credentials against AUTH_USERNAME/AUTH_PASSWORD and sets the cookie to
# AUTH_TOKEN on success. To disable the gate without removing the
# middleware file, set AUTH_DISABLED=true.

AUTH_USERNAME=natrx
AUTH_PASSWORD=resili3nc3
AUTH_TOKEN=rotate-this-to-invalidate-all-sessions
# AUTH_DISABLED=true
